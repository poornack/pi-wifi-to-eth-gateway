# Copy to ./config.local and fill in. config.local is gitignored.

# Password for FIRST_USER_NAME (required by DISABLE_FIRST_BOOT_USER_RENAME=1)
FIRST_USER_PASS='changeme'

# WiFi regulatory domain. REQUIRED: without it pi-gen leaves WiFi disabled.
WPA_COUNTRY='CA'

# WiFi network the Pi joins. Baked into the image as a NetworkManager keyfile
# (root-only, mode 600) so the Pi comes up on WiFi at first boot.
# Leave WIFI_SSID empty to skip.
export WIFI_SSID='WeHaveWifiNow'
export WIFI_PSK='wifi-password-here'
