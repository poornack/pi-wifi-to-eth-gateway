#!/bin/sh
# Message of the day (MOTD): the status text printed every time you SSH into
# the Pi. Shows the gateway's addresses, the wired devices it knows about, and
# a reminder of how it is set up. Reads live state and the dnsmasq config, so
# it stays correct if addresses are changed later.
CONF=/etc/dnsmasq.d/gateway-ethernet.conf
RESERVATIONS=/etc/dnsmasq.d/gateway-reservations.conf
LEASES=/var/lib/misc/dnsmasq.leases

ESC=$(printf '\033')
B="${ESC}[1m"; D="${ESC}[2m"; R="${ESC}[0m"
CY="${ESC}[36m"; GR="${ESC}[32m"; YE="${ESC}[33m"; RD="${ESC}[31m"; MG="${ESC}[35m"; BL="${ESC}[34m"
ok()  { printf '%s%s%s' "$GR" "$1" "$R"; }
bad() { printf '%s%s%s' "$RD" "$1" "$R"; }

eth=$(sed -n 's/^interface=//p' "$CONF" 2>/dev/null | head -1); eth=${eth:-eth0}
wifi=$(nmcli -t -f DEVICE,TYPE device 2>/dev/null | awk -F: '$2=="wifi"{print $1; exit}'); wifi=${wifi:-wlan0}
range=$(sed -n 's/^dhcp-range=//p' "$CONF" 2>/dev/null | head -1)
gw=$(sed -n 's/^dhcp-option=option:router,//p' "$CONF" 2>/dev/null | head -1)

wifi_ip=$(ip -4 -o addr show "$wifi" 2>/dev/null | awk '{print $4}' | cut -d/ -f1)
wifi_mac=$(cat /sys/class/net/$wifi/address 2>/dev/null)
eth_ip=$(ip -4 -o addr show "$eth" 2>/dev/null | awk '{print $4}')
eth_net=$(ip -4 route show dev "$eth" 2>/dev/null | awk '/proto kernel/{print $1}' | head -1)
if [ "$(cat /sys/class/net/$eth/carrier 2>/dev/null)" = "1" ]; then eth_link=$(ok up); else eth_link=$(bad DOWN); fi
if [ "$(cat /proc/sys/net/ipv4/ip_forward)" = "1" ]; then fwd=$(ok on); else fwd=$(bad OFF); fi
st=$(systemctl is-active dnsmasq 2>/dev/null); if [ "$st" = active ]; then dns=$(ok active); else dns=$(bad "$st"); fi

printf '\n%s%s=== WiFi -> Ethernet gateway ===%s\n' "$B" "$CY" "$R"
printf '  %s%-6s%s WiFi side (home network) : %s%s%s\n' "$B" "$wifi" "$R" "$YE" "${wifi_ip:-none}" "$R"
printf '  %s%-6s%s Ethernet side %-13s: %s%s%s   link %s\n' "$B" "$eth" "$R" "${eth_net:-}" "$YE" "${eth_ip:-none}" "$R" "$eth_link"
printf '  forwarding: %s   dnsmasq (DHCP/DNS): %s   DHCP pool: %s\n' "$fwd" "$dns" "${range:-?}"

printf '\n%s%s--- Wired devices on %s ---%s\n' "$B" "$CY" "$eth" "$R"
sed -n 's/^dhcp-host=//p' "$RESERVATIONS" 2>/dev/null | while IFS=, read -r mac name ip; do
	printf '  %s%-15s%s %s%-18s%s %s (reserved)\n' "$YE" "$ip" "$R" "$D" "$mac" "$R" "$name"
done
if [ -s "$LEASES" ]; then
	awk -v y="$YE" -v d="$D" -v r="$R" '{ printf "  %s%-15s%s %s%-18s%s %s (DHCP lease)\n", y, $3, r, d, $2, r, ($4=="*"?"unknown":$4) }' "$LEASES"
else
	printf '  %s(no DHCP leases yet)%s\n' "$D" "$R"
fi
printf '  Currently responding: %s' "$GR"
ip -4 neigh show dev "$eth" 2>/dev/null | awk '$NF=="REACHABLE"||$NF=="STALE"||$NF=="DELAY"{printf "%s ", $1}'
printf '%s\n' "$R"

printf '\n%s%s--- Handy commands ---%s\n' "$B" "$CY" "$R"
printf '  %s%-40s%s %s# %s%s\n' "$MG" 'ip -br -4 addr' "$R" "$D" "this Pi's addresses" "$R"
printf '  %s%-40s%s %s# %s%s\n' "$MG" "cat $LEASES" "$R" "$D" "DHCP clients (wired devices) and their addresses" "$R"
printf '  %s%-40s%s %s# %s%s\n' "$MG" "ip -4 neigh show dev $eth" "$R" "$D" "everything currently seen on the cable" "$R"
printf '  %s%-40s%s %s# %s%s\n' "$MG" 'sudo journalctl -u dnsmasq -f' "$R" "$D" "watch DHCP requests live" "$R"
printf '  %s%-40s%s %s# %s%s\n' "$MG" 'nmtui' "$R" "$D" "change WiFi network" "$R"

printf '\n%s%s--- How this Pi is set up ---%s\n' "$B" "$CY" "$R"
printf '  %s*%s Ethernet side has the fixed address %s on %s (NetworkManager profile %s"gateway-ethernet"%s).\n' "$BL" "$R" "${eth_ip:-?}" "$eth" "$B" "$R"
printf '  %s*%s dnsmasq (%s%s%s) hands out %s to wired devices\n' "$BL" "$R" "$B" "$CONF" "$R" "${range:-?}"
printf '    and tells them to use %s as gateway and DNS. Fixed addresses: %s%s%s\n' "${gw:-?}" "$B" "$RESERVATIONS" "$R"
printf '  %s*%s Packets are forwarded between the two sides (%s/etc/sysctl.d/99-ip-forward.conf%s).\n' "$BL" "$R" "$B" "$R"
printf '    Home network <-> wired devices is not NATed, so devices keep their real %s address.\n' "${eth_net:-}"
printf '    Only internet-bound traffic is masqueraded (%s/etc/nftables.conf%s).\n' "$B" "$R"
printf '  %s*%s Your home router needs a static route: %s -> this Pi'"'"'s WiFi IP (%s).\n' "$BL" "$R" "${eth_net:-?}" "${wifi_ip:-?}"
printf '    Reserve that IP on the router so it never changes (WiFi MAC %s%s%s).\n' "$D" "${wifi_mac:-?}" "$R"
printf '  %s*%s Image built from github.com/poornack/pi-wifi-to-eth (pi-gen + stage-gateway).\n\n' "$BL" "$R"
