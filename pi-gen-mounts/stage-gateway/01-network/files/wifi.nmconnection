# NetworkManager profile for the Pi's WiFi side: joins the home network and
# takes whatever address the home router hands out.
[connection]
id=${WIFI_SSID}
type=wifi
interface-name=${GATEWAY_WIFI_IF}
autoconnect=true

[wifi]
mode=infrastructure
ssid=${WIFI_SSID}

[wifi-security]
auth-alg=open
key-mgmt=wpa-psk
psk=${WIFI_PSK}

[ipv4]
method=auto

[ipv6]
method=auto
addr-gen-mode=default

[proxy]
