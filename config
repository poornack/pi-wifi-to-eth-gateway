# pi-gen configuration for the WiFi -> Ethernet router image.
# Secrets (passwords, WiFi PSK) live in ./config.local (gitignored, see
# config.local.example). ./build.sh concatenates the two before calling pi-gen.

IMG_NAME="pi-wifi-to-eth"
PI_GEN_RELEASE="WiFi <-> Ethernet Bridge - Silver Ave TP Link"
DEPLOY_COMPRESSION=none

LOCALE_DEFAULT='en_CA.UTF-8'
KEYBOARD_KEYMAP='ca'
KEYBOARD_LAYOUT='Canada'
TIMEZONE_DEFAULT='America/Los_Angeles'
TARGET_HOSTNAME='pServer-pi-0'

FIRST_USER_NAME='poorna'
# FIRST_USER_PASS is set in config.local
# Keep FIRST_USER_NAME as-is on first boot (also stops the "SSH may not work
# until a valid user has been set up" pre-login banner from being installed).
DISABLE_FIRST_BOOT_USER_RENAME=1
PASSWORDLESS_SUDO=0

ENABLE_SSH=1
PUBKEY_ONLY_SSH=0
PUBKEY_SSH_FIRST_USER="ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIAnP6BCWZIIA0jWDNd9ZAHB4s14lud2eDPuR77BKE1wC poornakalidas@gmail.com"

# stage-bridge is this repo's custom stage; build.sh bind-mounts it into the
# pi-gen container. Only stage-bridge exports an image (build.sh adds
# SKIP_IMAGES to stage2).
STAGE_LIST="stage0 stage1 stage2 stage-bridge"

# ---- Bridge / router settings (consumed by stage-bridge) -------------------
# Everything below must be exported so pi-gen's sub-stage scripts can see it.
export BRIDGE_ETH_IF="eth0"
export BRIDGE_WLAN_IF="wlan0"
export BRIDGE_ETH_IP="192.168.2.1"
export BRIDGE_ETH_PREFIX="24"
export BRIDGE_ETH_NET="192.168.2.0/24"
export BRIDGE_DHCP_START="192.168.2.10"
export BRIDGE_DHCP_END="192.168.2.100"
export BRIDGE_DHCP_LEASE="12h"
# Static DHCP reservations, one "mac,name,ip" per line. .2-.9 are kept out of
# the pool for these.
export BRIDGE_DHCP_HOSTS="bc:fc:e7:20:59:87,esxi,192.168.2.5"
# Home-router LAN. Traffic to/from it is routed without NAT; only traffic from
# BRIDGE_ETH_NET to anywhere else (the internet) is masqueraded.
export BRIDGE_HOME_LAN="192.168.0.0/24"
